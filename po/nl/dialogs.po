#: api/views.py:1042
msgid ""
"You are not allowed to trigger a refresh on this branch. You do not have the "
"required permissions. You need to be a site admin, a team coordinator, or a "
"maintainer of the module."
msgstr "U bent niet gerechtigd om deze branch te vernieuwen. U heeft niet de vereiste rechten. U moet een sitebeheerder, een teamcoördinator of een onderhouder van de module zijn."

#: api/views.py:1051
msgid "A refresh is already in progress."
msgstr "Vernieuwen wordt al uitgevoerd."

#: api/views.py:1061
msgid "Refresh started."
msgstr "Vernieuwen gestart."

#: common/vcs/checkout.py:224 common/vcs/checkout.py:465
#, python-format
msgid "Git repository %s is not valid. Calling ‘git-status’ failed."
msgstr "Git-bron %s is niet geldig. ‘git-status’ is mislukt."

#: common/vcs/checkout.py:251 common/vcs/checkout.py:521
#, python-format
msgid "Git repository at %(name)s could not be cloned. %(command_error)s"
msgstr "Git-bron op %(name)s kon niet gekloond worden. %(command_error)s"

#: common/vcs/checkout.py:271 common/vcs/checkout.py:566
#, python-format
msgid "Git repository %(name)s could not be fetched: %(command_error)s"
msgstr "Git-bron %(name)s kon niet opgehaald worden: %(command_error)s"

#: common/vcs/checkout.py:296 common/vcs/checkout.py:647
#, python-format
msgid "Git repository %(name)s could not be updated: %(command_error)s"
msgstr "Git-bron %(name)s kon niet bijgewerkt worden: %(command_error)s"

#: common/vcs/checkout.py:311
#, python-format
msgid ""
"Git repository %(name)s could not checkout to feature branch: "
"%(command_error)s"
msgstr "Git-bron %(name)s kon niet uitchecken naar de objectbranch: %(command_error)s"

#: common/vcs/checkout.py:327 common/vcs/checkout.py:688
#, python-format
msgid ""
"Git repository %(name)s could not create feature branch: %(command_error)s"
msgstr "Git-bron %(name)s kon geen objectbranch maken: %(command_error)s"

#: common/vcs/checkout.py:354 common/vcs/checkout.py:719
#, python-format
msgid ""
"Git branch ‘%(name)s’ could not be renamed in repository: %(command_error)s"
msgstr "Git-branch ‘%(name)s’ kon niet hernoemd worden in bron: %(command_error)s"

#: common/vcs/checkout.py:369 common/vcs/checkout.py:784
msgid ""
"Git repository could not be removed due to insufficient rights on the "
"filesystem."
msgstr "Git-bron kon niet verwijderd worden door ontoereikende toegangsrechten op het bestandssysteem."

#: common/vcs/checkout.py:396 common/vcs/checkout.py:870
#, python-format
msgid ""
"Git branch ‘%(name)s’ could not be removed from repository: %(command_error)s"
msgstr "Git-branch ‘%(name)s’ kon niet verwijderd worden uit bron: %(command_error)s"

#: common/vcs/checkout.py:588
#, python-format
msgid ""
"Git repository %(name)s could not create a worktree for branch ‘%(branch)s’: "
"%(command_error)s"
msgstr "Git-bron %(name)s kon geen werkboom maken voor branch ‘%(branch)s’: %(command_error)s"

#: common/vcs/committer.py:119
#, python-format
msgid "Git repository %(name)s could not be committed: %(command_error)s"
msgstr "Git-bron %(name)s kon niet ingezonden worden: %(command_error)s"

#: common/vcs/committer.py:291
#, python-format
msgid ""
"Git repository %(name)s could not cherry-pick commit ‘%(hash)s’: "
"%(command_error)s"
msgstr "Git-bron %(name)s kon de aanpassingen aan ‘%(hash)s’ niet ook naar de hoofdbranch sturen: %(command_error)s"

#: common/vcs/git_helpers.py:59
#, python-format
msgid "Git remote branches could not be listed for %(url)s: %(command_error)s"
msgstr "Git branches op afstand konden niet worden vermeld voor %(url)s: %(command_error)s"

#: common/vcs/push.py:146
#, python-format
msgid ""
"Git repository %(name)s could not be pushed: %(command_error)s. The branch "
"seems protected and Damned Lies is unable to push references to the "
"repository. Ask the project maintenance team to update the protection for "
"branches to allow Damned Lies to push commits."
msgstr "Git-bron %(name)s kon niet gepusht worden: %(command_error)s. De branch ziet er beschermd uit en Damned Lies kan geen referenties naar de bron pushen. Vraag het beheersteam van het project om de bescherming voor branches bij te werken zodat Damned Lies inzendingen kan pushen."

#: common/vcs/push.py:155
#, python-format
msgid ""
"Git repository %(name)s could not be pushed because of an unknown error: "
"%(command_error)s"
msgstr "Git-bron %(name)s kon niet gepusht worden door een onbekende fout: %(command_error)s"

#: common/vcs/push.py:235
#, python-format
msgid ""
"Git repository %(name)s could not create a %(request_type)s: "
"%(command_error)s"
msgstr "Git-bron %(name)s kon geen %(request_type)s maken: %(command_error)s"

#: common/vcs/push.py:284
#, python-format
msgid ""
"Git repository %(name)s could not push branch: %(command_error)s. The branch "
"seems protected and Damned Lies is unable to push references to the "
"repository. Ask the project maintenance team to update the protection for "
"branches to allow Damned Lies to push commits."
msgstr "Git-bron %(name)s kon branch niet pushen: %(command_error)s. De branch ziet er beschermd uit en Damned Lies kan geen referenties naar de bron pushen. Vraag het beheersteam van het project om de bescherming voor branches bij te werken zodat Damned Lies inzendingen kan pushen."

#: common/vcs/push.py:449
#, python-format
msgid ""
"Git repository %(name)s could not create a pull request: GitHub CLI (gh) is "
"not installed. Please install it from https://cli.github.com/"
msgstr "Git-bron %(name)s kon geen pull request maken: GitHub CLI (gh) is niet geïnstalleerd. Installeer het vanaf https://cli.github.com/"

#: common/vcs/push.py:463
#, python-format
msgid ""
"Git repository %(name)s could not create a pull request: A pull request "
"already exists for this branch."
msgstr "Git-bron %(name)s kon geen pull request maken: Er bestaat al een pull request voor deze branch."

#: common/views.py:49
msgid "translator-credits"
msgstr "Vincent van Adrighem, Wouter Bolsterlee, Hannie Dumoleyn, Sense Hofstede, Justin van Steijn, Reinout van Schouwen en Nathan Follens."

