msgid "<keycap>Arrow keys</keycap>"
msgstr "<keycap>Tasti freccia</keycap>"

#: src/key-reference.xml:499(para) src/key-reference.xml:515(para)
msgid "Scroll canvas"
msgstr "Scorre la superficie"

#: src/key-reference.xml:501(para)
msgid ""
"Combining the arrow keys with the <keycap function=\"shift\">Shift</keycap> "
"key increases the amount of scrolling. Using the arrow keys with the <keycap "
"function=\"control\">Ctrl</keycap> key jumps to the border of the image."
msgstr "Combinando i tasti freccia con il tasto <keycap function=\"shift\">Maiusc</keycap> si aumenta la quantità di scorrimento. Utilizzando i tasti freccia con il tasto <keycap function=\"control\">Ctrl</keycap> si passa direttamente al bordo dell'immagine."

#: src/key-reference.xml:513(term)
msgid "middle button drag"
msgstr "trascinamento col pulsante centrale"

#: src/key-reference.xml:519(term)
msgid "mouse wheel"
msgstr "rotellina del mouse"

#: src/key-reference.xml:521(para)
msgid "Scroll canvas vertically"
msgstr "Scorre la superficie verticalmente"

